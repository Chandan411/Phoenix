# Backend Environment Variables
# Copy this to .env in the backend folder for production

PORT=8000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_TYPE=sqlite        # "sqlite", "postgres", or "libsql"
DATABASE_PATH=./billing.db  # Used when DATABASE_TYPE=sqlite
DATABASE_URL=<turso url>    # Used when DATABASE_TYPE=libsql
  # Format: turso://org-name/project-name?authToken=YOUR_TOKEN

# For production deployments, update:
# FRONTEND_URL=https://your-frontend-domain.com
